# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project URL. Safe to ship in the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Safe to ship in the client bundle because it
# is constrained by Row Level Security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL used to build public booking links (e.g. https://app.example.com).
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY.
# Never prefix these with EXPO_PUBLIC_ and never read them from application
# code -- doing so ships them to every user's device. Not needed to run the app.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
